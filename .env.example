# Copy this file to `.env.local` and fill in your values.
# Variables WITHOUT the VITE_ prefix stay on the server (Vite dev/preview
# middleware and the audio generation script) and never reach the browser.

# --- Fish Audio (https://fish.audio) -------------------------------------
FISH_AUDIO_API_KEY=

# TTS model sent in the `model` header: s1 | s2-pro | s2.1-pro | s2.1-pro-free | drama-3
FISH_AUDIO_MODEL=s2.1-pro

# Default voice model (reference_id) used for every language.
FISH_AUDIO_VOICE_ID=

# Optional per-language voices. They override FISH_AUDIO_VOICE_ID for that language.
FISH_AUDIO_VOICE_ID_EN=
FISH_AUDIO_VOICE_ID_ES=
FISH_AUDIO_VOICE_ID_FR=
FISH_AUDIO_VOICE_ID_DE=
FISH_AUDIO_VOICE_ID_ZH=
FISH_AUDIO_VOICE_ID_JA=

# Speaking speed for narration (0.5 - 2.0). Slightly slow is friendlier for kids.
FISH_AUDIO_SPEED=0.9

# --- Client --------------------------------------------------------------
# Try the live /api/tts proxy when a word has no pre-generated audio file.
VITE_ENABLE_TTS_PROXY=true

# Use the browser's built-in speech synthesis as a last resort.
VITE_ENABLE_SPEECH_FALLBACK=true

# Force the WebGL renderer even when WebGPU is available (handy for testing).
VITE_FORCE_WEBGL=false
